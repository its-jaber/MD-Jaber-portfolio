---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import Lightbox, { type LightboxItem } from '../../components/react/Lightbox';
import { stageLabels } from '../../content.config';
import { getProjects, isDraft, clean, frameLabel, draftHtmlWithSlots, resolveImage, widthsFor, displayOf, trimStyles, NARROW, type Project, type Trim } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const d = project.data;
const draft = isDraft(project);
const { Content } = await render(project);
const slotHtml = draft ? draftHtmlWithSlots(project) : undefined;

// Placeholder (TODO) values are never rendered.
const tagline = clean(d.tagline);
const summary = clean(d.summary);
const meta = [
  { k: 'Type', v: clean(d.kind) },
  { k: 'Role', v: clean(d.role) },
  { k: 'Year', v: clean(d.year) },
  { k: 'Client', v: clean(d.client) },
  { k: 'Stack', v: d.stack.length ? d.stack.join(' · ') : undefined },
].filter((m) => m.v);

const links = [
  { k: 'Visit live site', v: d.links.live },
  { k: 'View demo', v: d.links.demo },
  { k: 'View code', v: d.links.repo },
].filter((l) => l.v);

const label = frameLabel(project);
const stage = d.stage ? { ...stageLabels[d.stage], note: d.stageNote ?? stageLabels[d.stage].note } : undefined;

// Screenshot set for the fullscreen viewer: cover first, then the gallery. Missing files are skipped.
type Shot = { src: ImageMetadata; alt: string; caption?: string; device?: 'desktop' | 'mobile' };
const isMobile = (g: Shot) => g.device === 'mobile' || (!g.device && g.src.width < 900 && g.src.height / g.src.width > 1.6 && g.src.height / g.src.width < 2.6);
const isTall = (g: Shot) => !isMobile(g) && g.src.height / g.src.width > 1.25;
const coverImg = await resolveImage(project, d.cover);
const gallery: Shot[] = (
  await Promise.all(d.gallery.map(async (g) => ({ ...g, src: await resolveImage(project, g.src) })))
).filter((g): g is Shot => !!g.src);
const shots: Shot[] = [...(coverImg ? [{ src: coverImg, alt: d.coverAlt ?? '' }] : []), ...gallery];
const viewer: LightboxItem[] = await Promise.all(
  shots.map(async (g) => {
    const full = await getImage({ src: g.src, widths: widthsFor(g.src, [1080, 1600, 2400]), format: 'webp' });
    const trim = g.src === coverImg ? trimStyles(g.src, d.coverTrim as Trim | undefined) : undefined;
    const t = (d.coverTrim ?? [0, 0, 0, 0]) as Trim;
    return {
      src: full.src, srcset: full.srcSet.attribute, width: g.src.width, height: g.src.height, alt: g.alt, caption: g.caption, tall: isTall(g),
      trim: trim && { ...trim, w: g.src.width - t[1] - t[3], h: g.src.height - t[0] - t[2] },
    };
  }),
);
const coverNarrow = coverImg ? coverImg.width < NARROW : false;
const coverDisplay = coverImg ? displayOf(coverImg) : 'wide';
const coverTrim = coverImg ? trimStyles(coverImg, d.coverTrim as Trim | undefined) : undefined;
const galleryStart = coverImg ? 1 : 0;
---

<BaseLayout title={d.title} description={summary ?? d.title} noindex={draft}>
  <article class="case" style={`--accent:${d.accent}`}>
    {draft && <p class="case__draft"><span class="badge-draft">Draft</span> Preview only · not included in the production build</p>}

    <header class="case__head">
      <div class="case__aura" aria-hidden="true"></div>
      <div class="container">
        <a href="/work" class="case__back" data-reveal>← All projects</a>
        <p class="eyebrow" data-reveal style="--d:80">{d.category}{stage && <span class="stage-badge">{stage.label}</span>}</p>
        <h1 class="case__title" data-split>
          <span class="line-mask"><span>{d.title}</span></span>
        </h1>
        {tagline && <p class="case__tagline" data-reveal style="--d:250">{tagline}</p>}
        {stage?.note && <p class="case__stage" data-reveal style="--d:300"><strong>{stage.label}</strong> {stage.note}</p>}

        {
          meta.length > 0 && (
            <dl class="case__meta" data-reveal style="--d:350">
              {meta.map((m) => (
                <div>
                  <dt>{m.k}</dt>
                  <dd>{m.v}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          links.length > 0 && (
            <div class="case__links" data-reveal style="--d:420">
              {links.map((l, i) => (
                <a class={i === 0 ? 'btn' : 'btn btn--ghost'} href={l.v} target="_blank" rel="noopener noreferrer">
                  {l.k} <span class="arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="container">
      {
        coverImg && coverNarrow ? (
          <figure class="showcase case__cover-area" data-display={coverDisplay} data-reveal>
            <div class="showcase__stage">
              <div class="frame__canvas" aria-hidden="true"></div>
              {
                coverDisplay === 'page' ? (
                  <div class="device-browser" style={`max-width:${coverImg.width}px`}>
                    <div class="device-browser__bar" aria-hidden="true"><i></i><i></i><i></i><span>{label}</span></div>
                    <div class="preview" data-lightbox="0" tabindex="0" aria-label="Scrollable full-page screenshot. Press Enter to open it fullscreen.">
                      <Image src={coverImg} alt={d.coverAlt ?? ''} widths={[coverImg.width]} sizes={`${coverImg.width}px`} loading="eager" fetchpriority="high" />
                    </div>
                  </div>
                ) : (
                  <div class="device-phone" data-lightbox="0">
                    <span class="device-phone__island" aria-hidden="true"></span>
                    {
                      coverTrim ? (
                        <span class="trim" style={coverTrim.wrap}>
                          <Image src={coverImg} alt={d.coverAlt ?? ''} widths={[coverImg.width]} sizes={`${coverImg.width}px`} loading="eager" fetchpriority="high" style={coverTrim.img} />
                        </span>
                      ) : (
                        <Image src={coverImg} alt={d.coverAlt ?? ''} widths={[coverImg.width]} sizes={`${coverImg.width}px`} loading="eager" fetchpriority="high" />
                      )
                    }
                  </div>
                )
              }
            </div>
            <figcaption class="showcase__info">
              <p class="eyebrow">{coverDisplay === 'page' ? 'Full-page capture' : 'App screen'}</p>
              {d.coverAlt && <p class="showcase__desc">{d.coverAlt}</p>}
              <dl class="showcase__facts">
                <dt>Original size</dt><dd>{coverImg.width} × {coverImg.height} px</dd>
                <dt>Shown at</dt><dd>Real size, never enlarged</dd>
              </dl>
              <div class="showcase__actions">
                <button type="button" class="btn" data-lightbox="0">
                  View fullscreen <span class="arrow" aria-hidden="true">↗</span>
                </button>
              </div>
              <p class="showcase__hint">
                {
                  coverDisplay === 'page' ? (
                    <>
                      <span class="hint-fine">Scroll inside the window to explore the page, or click it to open fullscreen.</span>
                      <span class="hint-touch">Tap the page to open it fullscreen and scroll through it.</span>
                    </>
                  ) : (
                    <>
                      <span class="hint-fine">Click the screen to view it fullscreen. <kbd>Esc</kbd> closes.</span>
                      <span class="hint-touch">Tap the screen to view it fullscreen.</span>
                    </>
                  )
                }
              </p>
            </figcaption>
          </figure>
        ) : (
          <figure class="case__cover" data-reveal>
            {
              coverImg ? (
                <MediaFrame label={label} category={d.category}>
                  <button type="button" class="zoom" data-lightbox="0" data-cursor="view" aria-label={`View full screenshot: ${d.coverAlt ?? d.title}`}>
                    <Image src={coverImg} alt={d.coverAlt ?? ''} widths={widthsFor(coverImg, [640, 1080, 1600, 2000])} sizes="(min-width: 1360px) 1312px, 100vw" loading="eager" fetchpriority="high" />
                  </button>
                </MediaFrame>
              ) : (
                <MediaFrame label={label} category={d.category} />
              )
            }
          </figure>
        )
      }

      <div class="case__layout">
        <aside class="case__summary" data-reveal>
          <p class="eyebrow">Summary</p>
          {summary ? <p>{summary}</p> : <p class="slot">A two or three sentence overview of the project.</p>}
          {
            d.outcomes.length > 0 && (
              <dl class="case__outcomes">
                {d.outcomes.map((o) => (
                  <div>
                    <dd>{o.value}</dd>
                    <dt>{o.label}</dt>
                  </div>
                ))}
              </dl>
            )
          }
          {d.tags.length > 0 && <ul class="case__tags">{d.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
        </aside>

        <div class="prose" data-reveal style="--d:120">
          {slotHtml ? <Fragment set:html={slotHtml} /> : <Content />}
        </div>
      </div>

      {
        d.video && (
          <figure class="case__video" data-reveal>
            <video src={d.video.src} poster={d.video.poster} controls playsinline preload="metadata" />
            {d.video.caption && <figcaption>{d.video.caption}</figcaption>}
          </figure>
        )
      }

      {
        gallery.length > 0 ? (
          <div class="case__gallery">
            {gallery.map((g, i) => {
              const mobile = isMobile(g);
              const tall = isTall(g);
              return (
                <figure class:list={['tile', { 'tile--mobile': mobile, 'tile--tall': tall }]} data-reveal style={`--d:${(i % 2) * 120}`}>
                  <button type="button" class="zoom tile__btn" data-lightbox={String(galleryStart + i)} data-cursor="view" aria-label={`View full screenshot: ${g.alt}`}>
                    <Image
                      src={g.src}
                      alt={g.alt}
                      widths={widthsFor(g.src, mobile ? [360, 540, 720] : [640, 960, 1280])}
                      sizes={mobile ? '(min-width: 900px) 25vw, 50vw' : '(min-width: 900px) 50vw, 100vw'}
                      loading="lazy"
                      decoding="async"
                    />
                    {tall && <span class="tile__hint" aria-hidden="true">View full page</span>}
                  </button>
                  {g.caption && <figcaption>{g.caption}</figcaption>}
                </figure>
              );
            })}
          </div>
        ) : (
          draft && (
            <div class="case__gallery" aria-hidden="true">
              {[0, 1].map((i) => (
                <div class="shot" data-reveal style={`--d:${i * 120}`}>
                  <MediaFrame label={label} category={d.category} />
                </div>
              ))}
            </div>
          )
        )
      }
    </div>

    {viewer.length > 0 && <Lightbox client:idle items={viewer} title={d.title} />}

    {
      next && next.id !== project.id && (
        <a href={`/work/${next.id}`} class="case__next" data-cursor="view">
          <div class="container">
            <span class="eyebrow">Next project</span>
            <span class="case__next-title">
              {next.data.title} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      )
    }
  </article>
</BaseLayout>
