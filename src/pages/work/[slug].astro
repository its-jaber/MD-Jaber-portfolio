---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFrame from '../../components/MediaFrame.astro';
import { getProjects, isDraft, clean, frameLabel, draftHtmlWithSlots, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next?: Project;
}

const { project, next } = Astro.props;
const d = project.data;
const draft = isDraft(project);
const { Content } = await render(project);
const slotHtml = draft ? draftHtmlWithSlots(project) : undefined;

// Placeholder (TODO) values are never rendered.
const tagline = clean(d.tagline);
const summary = clean(d.summary);
const meta = [
  { k: 'Type', v: clean(d.kind) },
  { k: 'Role', v: clean(d.role) },
  { k: 'Year', v: clean(d.year) },
  { k: 'Client', v: clean(d.client) },
  { k: 'Stack', v: d.stack.length ? d.stack.join(' · ') : undefined },
].filter((m) => m.v);

const links = [
  { k: 'Visit live site', v: d.links.live },
  { k: 'View demo', v: d.links.demo },
  { k: 'View code', v: d.links.repo },
].filter((l) => l.v);

const label = frameLabel(project);
---

<BaseLayout title={d.title} description={summary ?? d.title} noindex={draft}>
  <article class="case" style={`--accent:${d.accent}`}>
    {draft && <p class="case__draft"><span class="badge-draft">Draft</span> Preview only · not included in the production build</p>}

    <header class="case__head">
      <div class="case__aura" aria-hidden="true"></div>
      <div class="container">
        <a href="/work" class="case__back" data-reveal>← All projects</a>
        <p class="eyebrow" data-reveal style="--d:80">{d.category}</p>
        <h1 class="case__title" data-split>
          <span class="line-mask"><span>{d.title}</span></span>
        </h1>
        {tagline && <p class="case__tagline" data-reveal style="--d:250">{tagline}</p>}

        {
          meta.length > 0 && (
            <dl class="case__meta" data-reveal style="--d:350">
              {meta.map((m) => (
                <div>
                  <dt>{m.k}</dt>
                  <dd>{m.v}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {
          links.length > 0 && (
            <div class="case__links" data-reveal style="--d:420">
              {links.map((l, i) => (
                <a class={i === 0 ? 'btn' : 'btn btn--ghost'} href={l.v} target="_blank" rel="noopener noreferrer">
                  {l.k} <span class="arrow" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="container">
      <figure class="case__cover" data-reveal>
        {
          d.cover ? (
            <MediaFrame label={label} category={d.category}>
              <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[800, 1400, 2000]} sizes="(min-width: 1360px) 1312px, 100vw" loading="eager" />
            </MediaFrame>
          ) : (
            <MediaFrame label={label} category={d.category} />
          )
        }
      </figure>

      <div class="case__layout">
        <aside class="case__summary" data-reveal>
          <p class="eyebrow">Summary</p>
          {summary ? <p>{summary}</p> : <p class="slot">A two or three sentence overview of the project.</p>}
          {
            d.outcomes.length > 0 && (
              <dl class="case__outcomes">
                {d.outcomes.map((o) => (
                  <div>
                    <dd>{o.value}</dd>
                    <dt>{o.label}</dt>
                  </div>
                ))}
              </dl>
            )
          }
          {d.tags.length > 0 && <ul class="case__tags">{d.tags.map((t) => <li class="chip">{t}</li>)}</ul>}
        </aside>

        <div class="prose" data-reveal style="--d:120">
          {slotHtml ? <Fragment set:html={slotHtml} /> : <Content />}
        </div>
      </div>

      {
        d.video && (
          <figure class="case__video" data-reveal>
            <video src={d.video.src} poster={d.video.poster} controls playsinline preload="metadata" />
            {d.video.caption && <figcaption>{d.video.caption}</figcaption>}
          </figure>
        )
      }

      {
        d.gallery.length > 0 ? (
          <div class="case__gallery">
            {d.gallery.map((g, i) => (
              <figure data-reveal style={`--d:${(i % 2) * 120}`}>
                <Image src={g.src} alt={g.alt} widths={[640, 1200]} sizes="(min-width: 900px) 50vw, 100vw" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ) : (
          draft && (
            <div class="case__gallery" aria-hidden="true">
              {[0, 1].map((i) => (
                <div class="shot" data-reveal style={`--d:${i * 120}`}>
                  <MediaFrame label={label} category={d.category} />
                </div>
              ))}
            </div>
          )
        )
      }
    </div>

    {
      next && next.id !== project.id && (
        <a href={`/work/${next.id}`} class="case__next" data-cursor="view">
          <div class="container">
            <span class="eyebrow">Next project</span>
            <span class="case__next-title">
              {next.data.title} <span class="arrow" aria-hidden="true">→</span>
            </span>
          </div>
        </a>
      )
    }
  </article>
</BaseLayout>
