---
/** Astro twin of react/MediaFrame.tsx (case-study pages). Keep markup in sync. */
import { glyphs } from '../lib/glyphs';

interface Props {
  label: string;
  category: string;
  /** Small native capture shown at real size over the canvas. */
  narrow?: boolean;
}
const { label, category, narrow = false } = Astro.props;
const paths = glyphs[category] ?? glyphs.Website!;
const hasMedia = Astro.slots.has('default');
---

<div class="frame">
  <div class="frame__bar" aria-hidden="true"><i></i><i></i><i></i><span class="frame__url">{label}</span></div>
  <div class:list={['frame__view', { 'frame__view--narrow': narrow }]}>
    {narrow && <div class="frame__canvas" aria-hidden="true" />}
    {
      hasMedia ? (
        <slot />
      ) : (
        <div class="frame__canvas" aria-hidden="true">
          <svg class="frame__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            {paths.map((d) => <path d={d} />)}
          </svg>
        </div>
      )
    }
  </div>
</div>
